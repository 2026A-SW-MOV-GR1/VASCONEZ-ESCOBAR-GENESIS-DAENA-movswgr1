<Page xmlns="http://schemas.nativescript.org/tns.xsd"
    navigatingTo="navigatingTo">

    <ActionBar title="Secretos" />

    <ScrollView>
        <StackLayout padding="20" spacing="15">
            <Label text="Clave" fontWeight="bold" />
            <TextField id="txtKey" hint="Ingrese la clave" text="{{ key }}" />

            <Label text="Valor" fontWeight="bold" />
            <TextField id="txtValue" hint="Ingrese el valor" text="{{ value }}" visibility="{{ valueVisibility }}" />

            <Label text="Almacenamiento" fontWeight="bold" />
            <ListPicker id="storagePicker" items="{{ storageOptions }}" selectedIndex="{{ selectedStorageIndex }}" />

            <Button text="Guardar" tap="saveSecret" />
            <Button text="Recuperar" tap="getSecret" />

            <Label id="lblResult" text="{{ result }}" textWrap="true" />
        </StackLayout>
    </ScrollView>
</Page>
